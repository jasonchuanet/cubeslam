{
  "name": "cubeslam",
  "version": "2.0.0",
  "private": true,
  "description": "Self-hosted Cube Slam",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node server/index.js",
    "dev": "npm run build && node --watch server/index.js",
    "test": "node --test test/*.test.js && node scripts/test-legacy.js",
    "test:browser": "node test/browser.js"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "debug": "4.4.3",
    "emitter-component": "1.1.2",
    "jquery": "3.7.1",
    "jsdom": "26.1.0",
    "mousetrap": "1.6.5",
    "nib": "1.2.0",
    "playwright": "1.56.1",
    "pug": "3.0.3",
    "stylus": "0.64.0"
  }
}
